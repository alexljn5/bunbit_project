{
    "$schema": "../node_modules/@tauri-apps/cli/schema.json",
    "productName": "Bunbit",
    "version": "0.0.5",
    "identifier": "com.alexljn5.bunbit",
    "build": {
        "beforeDevCommand": "",
        "beforeBuildCommand": "",
        "devUrl": null,
        "frontendDist": "../src"
    },
    "app": {
        "windows": [
            {
                "title": "Bunbit",
                "width": 850,
                "height": 850,
                "resizable": true,
                "fullscreen": false,
                "url": "intro.html"
            }
        ],
        "security": {
            "csp": "default-src 'self' asset: 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:1430; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src 'self' http://localhost:3000 http://127.0.0.1:1430; worker-src 'self' asset: http://127.0.0.1:1430;",
            "dangerousDisableAssetCspModification": true,
            "capabilities": [
                "default"
            ]
        }
    },
    "bundle": {
        "active": true,
        "icon": [
            "../src/img/logo/favicon.ico"
        ]
    }
}