{
    "id": "new_game_intro",
    "metadata": {
        "language": "en",
        "version": 3
    },
    "startNode": "intro_start",
    "nodes": {
        "intro_start": {
            "speaker": "patches",
            "expression": "neutral",
            "text": "Did you hear that?",
            "next": "vesper_intro"
        },
        "vesper_intro": {
            "speaker": "vesper",
            "expression": "neutral",
            "text": "Hear what? You have been jumpy all night.",
            "next": "patches_retort"
        },
        "patches_retort": {
            "speaker": "patches",
            "expression": "annoyed",
            "text": "Jumpy? You are the one who knocked over the lantern.",
            "next": "vesper_retort"
        },
        "vesper_retort": {
            "speaker": "vesper",
            "expression": "annoyed",
            "text": "That was ONE time. And it was your tail's fault.",
            "next": "patches_grumbles"
        },
        "patches_grumbles": {
            "speaker": "patches",
            "expression": "neutral",
            "text": "...Something is watching us. I am not imagining it this time.",
            "next": "vesper_reluctant"
        },
        "vesper_reluctant": {
            "speaker": "vesper",
            "expression": "neutral",
            "text": "Fine. I feel it too. ...Right there.",
            "next": "player_realization"
        },
        "player_realization": {
            "speaker": "patches",
            "expression": "neutral",
            "text": "Hold on. I can feel you there.",
            "events": [
                {
                    "type": "SET_FLAG",
                    "flag": "player_aware",
                    "value": true
                },
                {
                    "type": "PLAYER_RECOGNIZED"
                }
            ],
            "next": "patches_surprised"
        },
        "patches_surprised": {
            "speaker": "patches",
            "expression": "surprised",
            "text": "Oh! You can see us!",
            "next": "vesper_surprised"
        },
        "vesper_surprised": {
            "speaker": "vesper",
            "expression": "surprised",
            "text": "And you... you are watching us right now.",
            "next": "patches_after"
        },
        "patches_after": {
            "speaker": "patches",
            "expression": "neutral",
            "text": "Well. That explains the prickling in my ears.",
            "events": [
                {
                    "type": "SHOW_NAMES"
                }
            ],
            "next": "vesper_after"
        },
        "vesper_after": {
            "speaker": "vesper",
            "expression": "neutral",
            "text": "Told you something felt off. But the journey begins now.",
            "events": [
                {
                    "type": "SET_FLAG",
                    "flag": "intro_complete",
                    "value": true
                }
            ]
        }
    }
}